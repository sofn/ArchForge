<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  ArchForge Checkstyle rules.

  Division of labor: Spotless (Eclipse JDT formatter) owns formatting — indentation,
  brace placement, line wrapping. Checkstyle therefore focuses on the semantic checks
  Spotless cannot express: import hygiene, naming conventions, control-flow traps and
  structural rules. Formatting checks are deliberately excluded to avoid the two tools
  fighting over the same lines.

  Failures here block `test`/`check`/`build` (see the wiring in build.gradle.kts).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Checker-level: skip generated sources (Hibernate metamodel, processor output) -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="build[\/]generated[\/].*"/>
    </module>

    <module name="FileTabCharacter"/>

    <module name="LineLength">
        <property name="max" value="180"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://"/>
    </module>

    <module name="TreeWalker">
        <!-- ================= Import hygiene ================= -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="IllegalImport"/>

        <!-- ================= Naming ================= -->
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>
        <module name="ConstantName">
            <!-- slf4j convention: lowercase `log`/`logger` static fields are allowed -->
            <property name="format" value="^(log|logger|logging)$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="ParameterName"/>
        <module name="StaticVariableName">
            <!-- project mixes two accepted styles: PascalCase constants (INTRANET_IP_RANGES)
                 and camelCase Spring-injected/holder fields (log, context, encrypter).
                 The rule keeps a character-set floor instead of forcing one style. -->
            <property name="format" value="^[a-zA-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="TypeName"/>

        <!-- ================= Structure ================= -->
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="ModifierOrder"/>

        <!-- ================= Control-flow traps ================= -->
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>
        <module name="EqualsHashCode"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore|ignored"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="MissingSwitchDefault">
            <property name="severity" value="warning"/>
        </module>

        <!-- ================= Misc semantics ================= -->
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="StringLiteralEquality"/>
        <module name="NoFinalizer"/>
    </module>

    <!-- Suppressions: legacy zones to be cleaned up over time -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>
</module>
