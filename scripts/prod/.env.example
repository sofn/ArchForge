# Copy to scripts/prod/.env and customize
DB_USERNAME=archforge
DB_PASSWORD=replace-me-in-production
REDIS_PASSWORD=replace-me-in-production
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=archforge
# Required by the admin (no defaults in application-prod.yaml)
ARCH_FORGE_RSA_PRIVATE_KEY=replace-me-generated-by-archforge-init
CORS_ALLOWED_ORIGINS=https://admin.example.com
WEB_PUBLIC_URL=https://www.example.com
